rules_version = '2';

// Règles de sécurité Firestore pour Carnet de révisions.
// À coller dans la console Firebase (Firestore Database > Règles) ou à
// déployer avec : firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // L'admin doit avoir confirmé son email : sans ça, n'importe qui pourrait
    // lier cette adresse à un profil anonyme avant le vrai propriétaire.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'bouvet.clement@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    // Le propriétaire ne peut ni changer ni retirer le champ ownerId.
    function keepsOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // ---------- Profils ----------
    // Lisibles par tous (classement entre amis), modifiables par leur seul titulaire.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;
      allow delete: if isAdmin();
    }

    // ---------- Séances ----------
    // Lecture ouverte aux profils connectés (classement + fil d'activité).
    match /sessions/{id} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data);
      allow update: if (isOwner(resource.data) && keepsOwner())
        // Anciennes données sans propriétaire : seul l'admin peut les attribuer.
        || (isAdmin() && !('ownerId' in resource.data));
      allow delete: if isOwner(resource.data) || isAdmin();
    }

    // ---------- Évaluations ----------
    // Privées : visibles par leur propriétaire (et l'admin pour les sauvegardes).
    match /evaluations/{id} {
      allow read: if isOwner(resource.data) || isAdmin();
      allow create: if isOwner(request.resource.data);
      allow update: if (isOwner(resource.data) && keepsOwner())
        || (isAdmin() && !('ownerId' in resource.data));
      allow delete: if isOwner(resource.data) || isAdmin();
    }

    // ---------- Chat ----------
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // L'auteur peut retirer son message, l'admin peut modérer.
      allow delete: if (signedIn() && resource.data.senderId == request.auth.uid) || isAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
